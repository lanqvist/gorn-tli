node_modules/
dist/
out/
release/
# Иконка собирается скриптом (npm run icon), в репозитории не нужна.
build/icon.png
build/icon.ico
*.log
!test/fixtures/*.log
.DS_Store
.env
.vite/
# Локальные настройки Claude Code и его рабочие деревья.
.claude/
coverage/
*.db
*.db-wal
*.db-shm
# Вывод режима --observe: срезы, снимки окна, консоль renderer.
debug/

# Диагностические снимки окна (--capture) лежат в корне и в репозиторий не идут.
# Шаблон по имени ненадёжен: снимки называют как попало и они всё равно
# просачиваются. Игнорируем любые картинки в корне.
/*.png
/*.jpg
/*.webp

# Тексты клиента игры (тексты издателя) и извлечённые игровые файлы — только
# локально. Числа и ID из них переносятся в docs/prison/rules.md.
docs/prison/client-texts.*.md
# Все JSON с текстами (client-config, relic, event, localization-records…) и
# архив извлечённых игровых файлов source-files.zip. В git — только manifest
# (пути и контрольные суммы, без текстов).
docs/prison/client-data/*
!docs/prison/client-data/manifest.json
